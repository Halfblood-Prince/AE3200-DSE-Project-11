<?xml version="1.0"?>
<!-- ROS 2 package manifest for the Python-only Gazebo / OctoMap demo. -->
<package format="3">
  <!-- Package identity shown by ROS tooling. -->
  <name>ros_test</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic 3D lidar robot simulation with ROS 2 Jazzy Jalisco OctoMap mapping.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <!-- ament_python installs the Python entrypoints and shared assets. -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Message/runtime dependencies used by the Python nodes and launch bridges. -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>python3-setuptools</exec_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros</depend>

  <!-- Launch, Gazebo, OctoMap, and RViz runtime tools. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Test dependencies used by GitHub Actions and local ROS workspaces. -->
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-cov</test_depend>

  <!-- Keep colcon using the Python-based ament package type. -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
