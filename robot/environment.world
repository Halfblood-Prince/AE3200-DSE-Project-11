<?xml version="1.0"?>
<!-- Gazebo Harmonic world for the ROS 2 Jazzy mapping demo. -->
<sdf version="1.10">
  <world name="building_slam_world">
    <!-- Fast physics step keeps odometry and sensor updates smooth. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo systems: physics, GUI commands, scene updates, sensors, IMU. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Directional light provides stable shadows and scene depth cues. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Flat ground plane for the cuboid robot and obstacle environment. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 32</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 32</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.74 0.72 1</ambient>
            <diffuse>0.72 0.74 0.72 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter wall enclosing the full environment. -->
    <model name="environment_perimeter_wall">
      <static>true</static>

      <link name="perimeter_north_wall">
        <pose>0 15.85 0.75 0 0 0</pose>
        <collision name="collision"><geometry><box><size>40.0 0.3 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40.0 0.3 1.5</size></box></geometry><material><ambient>0.25 0.27 0.28 1</ambient><diffuse>0.25 0.27 0.28 1</diffuse></material></visual>
      </link>
      <link name="perimeter_south_wall">
        <pose>0 -15.85 0.75 0 0 0</pose>
        <collision name="collision"><geometry><box><size>40.0 0.3 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40.0 0.3 1.5</size></box></geometry><material><ambient>0.25 0.27 0.28 1</ambient><diffuse>0.25 0.27 0.28 1</diffuse></material></visual>
      </link>
      <link name="perimeter_west_wall">
        <pose>-19.85 0 0.75 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 32.0 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 32.0 1.5</size></box></geometry><material><ambient>0.25 0.27 0.28 1</ambient><diffuse>0.25 0.27 0.28 1</diffuse></material></visual>
      </link>
      <link name="perimeter_east_wall">
        <pose>19.85 0 0.75 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 32.0 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 32.0 1.5</size></box></geometry><material><ambient>0.25 0.27 0.28 1</ambient><diffuse>0.25 0.27 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Dense interior floor plan kept below the floor so only the perimeter bounds the map. -->
    <model name="building_floor_plan">
      <pose>0 0 -100 0 0 0</pose>
      <static>true</static>

      <!-- Outer walls -->
      <link name="north_wall_left">
        <pose>-4.5 5 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.0 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.2 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="north_wall_right">
        <pose>4.5 5 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.0 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.2 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="south_wall">
        <pose>2 -5 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>18 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>18 0.2 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="west_wall">
        <pose>-7 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 10 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="east_wall">
        <pose>11 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 10 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="north_extension_west_wall">
        <pose>-2.0 8.0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.0 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="north_extension_east_wall">
        <pose>2.0 8.0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.0 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="north_extension_top_wall">
        <pose>0 11 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.2 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.2 0.2 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="east_wing_top_wall">
        <pose>9 2.8 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.0 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0 0.2 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="east_wing_bottom_wall">
        <pose>9 -2.8 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.0 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0 0.2 1.2</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>

      <!-- Interior rooms and corridors -->
      <link name="left_vertical_room_wall">
        <pose>-3.6 2.2 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 3.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.0 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="left_room_bottom_wall">
        <pose>-5.7 -1.2 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.3 0.18 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.3 0.18 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="center_vertical_wall_upper">
        <pose>0.0 3.2 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 2.6 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 2.6 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="center_vertical_wall_lower">
        <pose>0.0 -3.6 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 1.6 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 1.6 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="middle_horizontal_wall_left">
        <pose>-2.7 0.2 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.6 0.18 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.18 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="middle_horizontal_wall_right">
        <pose>4.2 0.2 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.6 0.18 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.6 0.18 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="right_room_wall">
        <pose>3.0 3.4 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 2.4 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 2.4 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="right_room_bottom_wall">
        <pose>5.2 1.1 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.6 0.18 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.6 0.18 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="east_wing_divider_top">
        <pose>8.4 1.4 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 2.8 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 2.8 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="east_wing_divider_bottom">
        <pose>8.4 -1.9 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 1.8 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 1.8 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="north_extension_room_wall">
        <pose>0 8.3 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.0 0.18 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.18 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="bottom_room_wall_left">
        <pose>-4.2 -3.4 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 2.8 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 2.8 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="bottom_room_wall_right">
        <pose>3.6 -3.6 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.18 2.4 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 2.4 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>
      <link name="bottom_corridor_wall">
        <pose>2.4 -2.0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.4 0.18 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.4 0.18 1.2</size></box></geometry><material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      </link>

      <!-- Furniture-like obstacles for richer lidar features -->
      <link name="table_block_b">
        <pose>1.8 3.6 0.35 0 0 -0.2</pose>
        <collision name="collision"><geometry><box><size>1.1 0.6 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.1 0.6 0.7</size></box></geometry><material><ambient>0.18 0.45 0.7 1</ambient><diffuse>0.18 0.45 0.7 1</diffuse></material></visual>
      </link>
      <link name="pillar_a">
        <pose>5.2 -2.8 0.6 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry><material><ambient>0.7 0.62 0.2 1</ambient><diffuse>0.7 0.62 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Sparse non-wall landmarks for SLAM scan-matching in the open perimeter. -->
    <model name="sparse_slam_landmarks">
      <static>true</static>
      <link name="low_table">
        <pose>-7.0 -4.5 0.35 0 0 0.25</pose>
        <collision name="collision"><geometry><box><size>1.2 0.7 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.7 0.7</size></box></geometry><material><ambient>0.18 0.45 0.7 1</ambient><diffuse>0.18 0.45 0.7 1</diffuse></material></visual>
      </link>
      <link name="pillar_west">
        <pose>3.5 5.5 0.6 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry><material><ambient>0.7 0.62 0.2 1</ambient><diffuse>0.7 0.62 0.2 1</diffuse></material></visual>
      </link>
      <link name="tall_marker">
        <pose>9.0 -6.0 0.6 0 0 -0.4</pose>
        <collision name="collision"><geometry><box><size>0.7 1.4 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 1.4 1.2</size></box></geometry><material><ambient>0.45 0.22 0.55 1</ambient><diffuse>0.45 0.22 0.55 1</diffuse></material></visual>
      </link>
      <link name="crate_cluster_west">
        <pose>-9.5 1.0 0.45 0 0 0.6</pose>
        <collision name="collision"><geometry><box><size>1.0 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 0.9</size></box></geometry><material><ambient>0.55 0.32 0.18 1</ambient><diffuse>0.55 0.32 0.18 1</diffuse></material></visual>
      </link>
      <link name="pillar_center">
        <pose>-0.8 -1.8 0.6 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.42</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.42</radius><length>1.2</length></cylinder></geometry><material><ambient>0.2 0.55 0.35 1</ambient><diffuse>0.2 0.55 0.35 1</diffuse></material></visual>
      </link>
      <link name="bench_north">
        <pose>-1.0 8.0 0.35 0 0 0.05</pose>
        <collision name="collision"><geometry><box><size>2.2 0.55 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.55 0.7</size></box></geometry><material><ambient>0.36 0.42 0.58 1</ambient><diffuse>0.36 0.42 0.58 1</diffuse></material></visual>
      </link>
      <link name="crate_east">
        <pose>6.8 3.2 0.5 0 0 -0.25</pose>
        <collision name="collision"><geometry><box><size>1.4 0.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 0.8 1.0</size></box></geometry><material><ambient>0.65 0.44 0.16 1</ambient><diffuse>0.65 0.44 0.16 1</diffuse></material></visual>
      </link>
      <link name="round_column_south">
        <pose>-2.5 -8.5 0.7 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>1.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>1.4</length></cylinder></geometry><material><ambient>0.55 0.55 0.50 1</ambient><diffuse>0.55 0.55 0.50 1</diffuse></material></visual>
      </link>
      <link name="angled_barrier_southeast">
        <pose>10.5 -1.5 0.4 0 0 0.8</pose>
        <collision name="collision"><geometry><box><size>2.0 0.45 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.45 0.8</size></box></geometry><material><ambient>0.5 0.24 0.24 1</ambient><diffuse>0.5 0.24 0.24 1</diffuse></material></visual>
      </link>
      <link name="short_block_near_start">
        <pose>-3.0 1.2 0.3 0 0 -0.35</pose>
        <collision name="collision"><geometry><box><size>0.8 0.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.5 0.6</size></box></geometry><material><ambient>0.25 0.48 0.52 1</ambient><diffuse>0.25 0.48 0.52 1</diffuse></material></visual>
      </link>
      <link name="equipment_rack_northwest">
        <pose>-13.2 9.4 0.75 0 0 0.25</pose>
        <collision name="collision"><geometry><box><size>1.8 0.55 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.55 1.5</size></box></geometry><material><ambient>0.18 0.28 0.42 1</ambient><diffuse>0.18 0.28 0.42 1</diffuse></material></visual>
      </link>
      <link name="barrel_pair_southwest_a">
        <pose>-13.8 -9.2 0.55 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.32</radius><length>1.1</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.32</radius><length>1.1</length></cylinder></geometry><material><ambient>0.64 0.17 0.16 1</ambient><diffuse>0.64 0.17 0.16 1</diffuse></material></visual>
      </link>
      <link name="barrel_pair_southwest_b">
        <pose>-13.0 -8.6 0.45 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.82 0.54 0.18 1</ambient><diffuse>0.82 0.54 0.18 1</diffuse></material></visual>
      </link>
      <link name="inspection_gate_east_left">
        <pose>14.3 6.5 0.9 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.28 0.28 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.28 0.28 1.8</size></box></geometry><material><ambient>0.18 0.58 0.68 1</ambient><diffuse>0.18 0.58 0.68 1</diffuse></material></visual>
      </link>
      <link name="inspection_gate_east_right">
        <pose>14.3 8.1 0.9 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.28 0.28 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.28 0.28 1.8</size></box></geometry><material><ambient>0.18 0.58 0.68 1</ambient><diffuse>0.18 0.58 0.68 1</diffuse></material></visual>
      </link>
      <link name="inspection_gate_east_top">
        <pose>14.3 7.3 1.75 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 1.9 0.22</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 1.9 0.22</size></box></geometry><material><ambient>0.18 0.58 0.68 1</ambient><diffuse>0.18 0.58 0.68 1</diffuse></material></visual>
      </link>
      <link name="low_pallets_center">
        <pose>2.2 -6.8 0.22 0 0 0.45</pose>
        <collision name="collision"><geometry><box><size>2.0 1.0 0.44</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 1.0 0.44</size></box></geometry><material><ambient>0.45 0.34 0.21 1</ambient><diffuse>0.45 0.34 0.21 1</diffuse></material></visual>
      </link>
      <link name="sensor_tripod_north">
        <pose>7.4 10.6 0.85 0 0 -0.15</pose>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
