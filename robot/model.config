<?xml version="1.0"?>
<!-- Gazebo model manifest used by environment.world through model://robot. -->
<model>
  <name>robot</name>
  <version>1.0</version>
  <sdf version="1.10">robot.sdf</sdf>
  <author>
    <name>AeroSentinel Team</name>
  </author>
  <description>Sliding cuboid robot with 3D lidar, IMU, camera, velocity control, and odometry.</description>
</model>
