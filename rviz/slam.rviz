# RViz layout for viewing the 3D lidar cloud, TF tree, and OctoMap voxels.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # Ground grid gives visual scale in the fixed map frame.
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    # TF verifies map -> odom -> base_link -> lidar_link alignment.
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: true
    # Filtered lidar points remove robot self-hits and near-floor rings.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 80; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: 3D Lidar Points
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /points_filtered
      Use Fixed Frame: true
      Value: true
    # OctoMap publishes occupied voxels as visualization markers.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: OctoMap Voxels
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupied_cells_vis_array
      Value: true
    # Planned path from a saved .bt OctoMap through the bundled 3D A* helper.
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: A* Path
      Buffer Length: 1
      Color: 40; 255; 120
      Line Style: Lines
      Line Width: 0.08
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 0
      Pose Style: None
      Radius: 0.03
      Shaft Length: 0.1
      Shaft Radius: 0.03
      Head Length: 0.2
      Head Radius: 0.05
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /astar_path
      Value: true
  Enabled: true
  Global Options:
    # OctoMap uses map as the global frame.
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    # Basic interactive tools are enough for inspection and camera movement.
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    # Default orbit camera starts high enough to see the environment.
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 13
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.75
    Saved: ~
Window Geometry:
  # Conservative desktop size that fits common laptop screens.
  Height: 900
  Width: 1200
